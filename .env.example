# Copy to .env, replace every example key, then run uvicorn with --env-file .env.
EMABOX_PROVIDER=gemini
GEMINI_API_KEY=replace-with-gemini-key
OPENAI_API_KEY=replace-with-openai-key
EMABOX_GEMINI_MODEL=gemini-3.8-flash
EMABOX_OPENAI_MODEL=gpt-6-luna
EMABOX_DATABASE_URL=sqlite:///./emabox.db
EMABOX_API_CLIENTS={"diary-app":{"key":"replace-with-a-long-random-app-key","default_specialist":"journal"},"other-app":{"key":"replace-with-another-long-random-key"}}
EMABOX_LOG_RETENTION_DAYS=60

# Global Gemini ceiling; specialist limits can be lower.
EMABOX_GEMINI_MAX_OUTPUT_TOKENS=512
# Gemini 3 only; blank uses the model default. Check model support before changing models.
EMABOX_GEMINI_THINKING_LEVEL=minimal
# Blank uses the model default; Gemini 3 recommended default is 1.0.
EMABOX_GEMINI_TEMPERATURE=1.0
EMABOX_GENERIC_MAX_INPUT_TOKENS=1200
EMABOX_GENERIC_MAX_OUTPUT_TOKENS=256
EMABOX_SPECIALIST_MAX_OUTPUT_TOKENS=1200
