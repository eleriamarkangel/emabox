# Copy to .env, replace every example key, then run uvicorn with --env-file .env.
EMABOX_PROVIDER=gemini
GEMINI_API_KEY=replace-with-gemini-key
OPENAI_API_KEY=replace-with-openai-key
EMABOX_GEMINI_MODEL=gemini-3.8-flash
EMABOX_OPENAI_MODEL=gpt-6-luna
EMABOX_DATABASE_URL=sqlite:///./emabox.db
EMABOX_API_CLIENTS={"diary-app":{"key":"replace-with-a-long-random-app-key","default_specialist":"journal"},"other-app":{"key":"replace-with-another-long-random-key"}}
EMABOX_LOG_RETENTION_DAYS=40
